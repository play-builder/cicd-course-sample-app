{
  "name": "sample-app",
  "version": "1.0.0",
  "description": "CI/CD 와 GitOps 강의용 샘플 애플리케이션",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint .",
    "test": "node --test test/**/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage test/**/*.test.js"
  },
  "dependencies": {
    "@prometheus-io/client": "^0.16.1",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "eslint": "^10.9.1"
  }
}
